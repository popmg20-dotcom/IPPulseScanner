<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fragment_one_time_height"
    android:stateListAnimator="@xml/animate_scale_1dot05"
    app:cardElevation="0dp"
    app:contentPaddingBottom="12dp"
    app:contentPaddingLeft="16dp"
    app:contentPaddingRight="16dp"
    app:contentPaddingTop="12dp"
    app:strokeColor="@color/stroke_color"
    app:strokeWidth="1dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/local_proxy"
            app:drawableStartCompat="@drawable/ic_round_wifi_tethering_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DashboardSmallCardTitleStyle"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSecondary"
            android:id="@+id/socks5_title"
            android:background="@drawable/bg_socks5_label"
            android:padding="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="SOCKS5"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceBody1"
            android:id="@+id/socks5_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/socks5_title"
            app:layout_constraintStart_toEndOf="@+id/socks5_title"
            app:layout_constraintTop_toTopOf="@+id/socks5_title"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnPrimary"
            android:gravity="center"
            android:id="@+id/http_title"
            android:background="@drawable/bg_http_label"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="HTTP"
            app:layout_constraintEnd_toEndOf="@+id/socks5_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/socks5_title"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceBody1"
            android:id="@+id/http_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/http_title"
            app:layout_constraintStart_toEndOf="@+id/http_title"
            app:layout_constraintTop_toTopOf="@+id/http_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
