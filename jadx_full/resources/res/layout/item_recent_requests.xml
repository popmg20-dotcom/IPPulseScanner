<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:nextFocusLeft="@+id/rule"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:foreground="?attr/selectableItemBackground"
        android:scaleType="centerCrop"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody1"
        android:ellipsize="end"
        android:id="@+id/dest"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="3"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaption"
        android:id="@+id/info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/dest"
        app:layout_constraintStart_toStartOf="@+id/dest"
        app:layout_constraintTop_toBottomOf="@+id/dest"/>
    <HorizontalScrollView
        android:id="@+id/group"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:paddingStart="80dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info">
        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">
            <com.google.android.material.chip.Chip
                android:textAppearance="?attr/textAppearanceCaption"
                android:id="@+id/proxy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                app:chipBackgroundColor="@color/transparent"
                app:chipMinHeight="28dp"
                app:chipStrokeColor="@color/stroke_color"
                app:chipStrokeWidth="1dp"
                style="@style/Widget.Material3.Chip.Assist"/>
            <com.google.android.material.chip.Chip
                android:textAppearance="?attr/textAppearanceCaption"
                android:id="@+id/rule"
                android:nextFocusRight="@+id/root"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                app:chipBackgroundColor="@color/transparent"
                app:chipMinHeight="28dp"
                app:chipStrokeColor="@color/stroke_color"
                app:chipStrokeWidth="1dp"
                style="@style/Widget.Material3.Chip.Assist"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
