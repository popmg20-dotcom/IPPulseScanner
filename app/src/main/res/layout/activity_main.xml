<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0F172A"
    android:paddingTop="36dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
        <Button android:id="@+id/tab1Btn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="Range Scan (Tab 1)" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:backgroundTint="#0284C7" />
        <Space android:layout_width="8dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/tab2Btn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="Deep Gaming Test (Tab 2)" android:textColor="#94A3B8" android:textSize="13sp" android:textStyle="bold" android:backgroundTint="#1E293B" />
    </LinearLayout>

    <ScrollView android:id="@+id/tab1View" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="visible">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/ipInput" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Enter IP or Range (e.g. 93.119.170.0-255)" android:textColor="#FFFFFF" android:textColorHint="#64748B" android:textSize="14sp" android:padding="10dp" android:background="#1E293B" android:layout_marginBottom="10dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Packets" android:textColor="#38BDF8" android:textSize="12sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/t1Packets" android:layout_width="match_parent" android:layout_height="42dp" android:text="50" android:inputType="number" android:textColor="#FFFFFF" android:gravity="center" android:background="#1E293B" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <Space android:layout_width="6dp" android:layout_height="wrap_content"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Interval (ms)" android:textColor="#38BDF8" android:textSize="12sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/t1Interval" android:layout_width="match_parent" android:layout_height="42dp" android:text="1" android:inputType="number" android:textColor="#FFFFFF" android:gravity="center" android:background="#1E293B" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <Space android:layout_width="6dp" android:layout_height="wrap_content"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Timeout (ms)" android:textColor="#38BDF8" android:textSize="12sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/t1Timeout" android:layout_width="match_parent" android:layout_height="42dp" android:text="1000" android:inputType="number" android:textColor="#FFFFFF" android:gravity="center" android:background="#1E293B" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                <Button android:id="@+id/btnStart1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:text="START" android:textColor="#FFFFFF" android:textStyle="bold" android:backgroundTint="#2563EB"/>
                <Space android:layout_width="10dp" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnStop1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:text="STOP" android:textColor="#FFFFFF" android:textStyle="bold" android:backgroundTint="#DC2626"/>
            </LinearLayout>

            <TextView android:id="@+id/t1Status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready" android:textColor="#94A3B8" android:gravity="center" android:textSize="13sp" android:layout_marginBottom="8dp"/>

            <ScrollView android:id="@+id/t1LogScroll" android:layout_width="match_parent" android:layout_height="110dp" android:background="#090D16" android:padding="8dp" android:layout_marginBottom="12dp">
                <LinearLayout android:id="@+id/t1LogLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </ScrollView>

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/t1Table" android:layout_width="wrap_content" android:layout_height="wrap_content" android:stretchColumns="*"/>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <ScrollView android:id="@+id/tab2View" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/t2TargetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Top 5 IPs Target: (Run Tab 1 scan first)" android:textColor="#FBBF24" android:textStyle="bold" android:textSize="13sp" android:gravity="center" android:layout_marginBottom="10dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Packets" android:textColor="#F59E0B" android:textSize="12sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/t2Packets" android:layout_width="match_parent" android:layout_height="42dp" android:text="300" android:inputType="number" android:textColor="#FFFFFF" android:gravity="center" android:background="#1E293B" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <Space android:layout_width="6dp" android:layout_height="wrap_content"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Interval (ms)" android:textColor="#F59E0B" android:textSize="12sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/t2Interval" android:layout_width="match_parent" android:layout_height="42dp" android:text="1" android:inputType="number" android:textColor="#FFFFFF" android:gravity="center" android:background="#1E293B" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <Space android:layout_width="6dp" android:layout_height="wrap_content"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Timeout (ms)" android:textColor="#F59E0B" android:textSize="12sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/t2Timeout" android:layout_width="match_parent" android:layout_height="42dp" android:text="500" android:inputType="number" android:textColor="#FFFFFF" android:gravity="center" android:background="#1E293B" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                <Button android:id="@+id/btnStart2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:text="START DEEP TEST" android:textColor="#FFFFFF" android:textStyle="bold" android:backgroundTint="#D97706"/>
                <Space android:layout_width="10dp" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnStop2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:text="STOP" android:textColor="#FFFFFF" android:textStyle="bold" android:backgroundTint="#DC2626"/>
            </LinearLayout>

            <TextView android:id="@+id/t2Status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready for Deep Test" android:textColor="#94A3B8" android:gravity="center" android:textSize="13sp" android:layout_marginBottom="8dp"/>

            <ScrollView android:id="@+id/t2LogScroll" android:layout_width="match_parent" android:layout_height="110dp" android:background="#090D16" android:padding="8dp" android:layout_marginBottom="12dp">
                <LinearLayout android:id="@+id/t2LogLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </ScrollView>

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/t2Table" android:layout_width="wrap_content" android:layout_height="wrap_content" android:stretchColumns="*"/>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
