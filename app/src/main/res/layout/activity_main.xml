<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0F172A"
    android:paddingTop="36dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingBottom="12dp"
    android:layoutDirection="ltr">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="IP PULSE SCANNER (TURBO GAMING)"
        android:textColor="#38BDF8" android:textSize="17sp" android:textStyle="bold"
        android:gravity="center" android:layout_marginBottom="16dp"/>

    <EditText android:id="@+id/ipInput" android:layout_width="match_parent" android:layout_height="75dp"
        android:hint="3.122.114.0 - 3.122.114.255" android:textColor="#FFFFFF"
        android:textColorHint="#64748B" android:background="#1E293B" android:padding="10dp"
        android:gravity="top|left" android:textSize="14sp" android:layout_marginBottom="16dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Packets" android:textColor="#38BDF8" android:textSize="12sp"/>
            <EditText android:id="@+id/inputPackets" android:layout_width="match_parent" android:layout_height="45dp" android:text="100" android:inputType="number" android:textColor="#FFFFFF" android:gravity="center" android:background="#1E293B" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <Space android:layout_width="8dp" android:layout_height="wrap_content"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Interval (ms)" android:textColor="#38BDF8" android:textSize="12sp"/>
            <EditText android:id="@+id/inputInterval" android:layout_width="match_parent" android:layout_height="45dp" android:text="1" android:inputType="number" android:textColor="#FFFFFF" android:gravity="center" android:background="#1E293B" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <Space android:layout_width="8dp" android:layout_height="wrap_content"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Timeout (ms)" android:textColor="#38BDF8" android:textSize="12sp"/>
            <EditText android:id="@+id/inputTimeout" android:layout_width="match_parent" android:layout_height="45dp" android:text="1000" android:inputType="number" android:textColor="#FFFFFF" android:gravity="center" android:background="#1E293B" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
        <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="START" android:textColor="#FFFFFF" android:textStyle="bold" android:backgroundTint="#2563EB"/>
        <Space android:layout_width="12dp" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="STOP" android:textColor="#FFFFFF" android:textStyle="bold" android:backgroundTint="#DC2626"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <TextView android:id="@+id/status1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آماده برای اسکن فوق‌سریع..." android:textColor="#94A3B8" android:gravity="right" android:textSize="12sp" android:layout_marginBottom="8dp"/>

            <ScrollView android:id="@+id/logScroll1" android:layout_width="match_parent" android:layout_height="120dp" android:background="#162032" android:padding="8dp" android:layout_marginBottom="20dp">
                <LinearLayout android:id="@+id/logLayout1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </ScrollView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🏆 تست تخصصی و پیشرفته ۵ آی‌پی برتر (مخصوص گیمینگ)" android:textColor="#FBBF24" android:textStyle="bold" android:gravity="right" android:textSize="13sp" android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/status2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="در انتظار پایان اسکن رنج..." android:textColor="#94A3B8" android:gravity="right" android:textSize="12sp" android:layout_marginBottom="8dp"/>

            <ScrollView android:id="@+id/logScroll2" android:layout_width="match_parent" android:layout_height="120dp" android:background="#162032" android:padding="8dp" android:layout_marginBottom="20dp">
                <LinearLayout android:id="@+id/logLayout2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </ScrollView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📋 کل لیست نتایج رنج (برای کپی کلیک کنید):" android:textColor="#94A3B8" android:gravity="right" android:textSize="13sp" android:layout_marginBottom="8dp"/>

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TableLayout android:id="@+id/resultsTable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:stretchColumns="*"/>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
