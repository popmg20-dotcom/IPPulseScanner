<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical">

    <!-- تب‌ها -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">
        <Button android:id="@+id/tab1Btn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="RANGE SCAN" android:backgroundTint="#2563EB"/>
        <Button android:id="@+id/tab2Btn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="GAMING TEST" android:backgroundTint="#1E293B"/>
    </LinearLayout>

    <!-- کانتینر اصلی -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        
        <!-- تب اول: اسکن رنج -->
        <ScrollView android:id="@+id/tab1Container" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <EditText android:id="@+id/ipInput" android:layout_width="match_parent" android:layout_height="60dp" android:background="#1E293B" android:textColor="#FFFFFF" android:text="3.122.114.0 - 3.122.114.255" android:hint="IP Range" android:padding="8dp" android:layout_marginBottom="10dp"/>
                <Button android:id="@+id/btnStart1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="START SCAN" android:backgroundTint="#059669"/>
                <TextView android:id="@+id/statusText1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#94A3B8" android:text="آماده..."/>
                <ScrollView android:id="@+id/logScrollView" android:layout_width="match_parent" android:layout_height="150dp" android:background="#1E293B" android:padding="5dp" android:layout_marginTop="10dp">
                    <LinearLayout android:id="@+id/logLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                </ScrollView>
                <TableLayout android:id="@+id/resultTable" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
            </LinearLayout>
        </ScrollView>

        <!-- تب دوم: گیمینگ تخصصی -->
        <ScrollView android:id="@+id/tab2Container" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:text="تست تخصصی ۵ آی‌پی برتر" android:textColor="#FBBF24" android:textSize="14sp" android:layout_marginBottom="10dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <EditText android:id="@+id/pInput2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="300" android:hint="Packets" android:inputType="number" android:textColor="#FFFFFF"/>
                    <EditText android:id="@+id/tInput2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="1000" android:hint="Timeout" android:inputType="number" android:textColor="#FFFFFF"/>
                </LinearLayout>
                <Button android:id="@+id/btnStart2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="START DEEP TEST" android:backgroundTint="#FBBF24"/>
                <TableLayout android:id="@+id/top5Table" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</LinearLayout>
