<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#09090B"
    android:paddingLeft="12dp" android:paddingRight="12dp"
    android:paddingBottom="12dp" android:paddingTop="28dp"
    android:fitsSystemWindows="true" android:layoutDirection="ltr">

    <ScrollView android:id="@+id/tab3Container" android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Gaming VPN / Network Lab" android:textColor="#FBBF24"
                android:textStyle="bold" android:gravity="center" android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DNS Server:" android:textColor="#38BDF8" android:textSize="12sp"/>
            <EditText android:id="@+id/vpnDns" android:layout_width="match_parent"
                android:layout_height="45dp" android:text="8.8.8.8" android:inputType="text"
                android:textColor="#FFFFFF" android:background="#18181B"
                android:padding="8dp" android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MTU:" android:textColor="#38BDF8" android:textSize="12sp"/>
            <EditText android:id="@+id/vpnMtu" android:layout_width="match_parent"
                android:layout_height="45dp" android:text="1400" android:inputType="number"
                android:textColor="#FFFFFF" android:background="#18181B"
                android:padding="8dp" android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Master IP (اعمال به همه دامنه‌ها):" android:textColor="#38BDF8" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <EditText android:id="@+id/vpnMasterIp" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="45dp" android:hint="مثلا 109.61.42.44"
                    android:textColor="#FFFFFF" android:textColorHint="#64748B"
                    android:background="#18181B" android:padding="8dp"
                    android:inputType="text" />
                <Button android:id="@+id/btnApplyIp" android:layout_width="wrap_content"
                    android:layout_height="45dp" android:text="Apply to All"
                    android:textColor="#FFFFFF" android:textStyle="bold"
                    android:backgroundTint="#2563EB" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Hosts Mapping (IP DOMAIN):" android:textColor="#38BDF8" android:textSize="12sp"/>
            <EditText android:id="@+id/vpnHosts" android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="109.61.42.44 west-tdm.codmwest.com\n109.61.42.44 west-cschannel.codm.activision.com\n109.61.42.44 gcloud.codm.activision.com"
                android:textColor="#FFFFFF" android:textColorHint="#64748B"
                android:background="#18181B" android:padding="8dp"
                android:gravity="top|left" android:textSize="12sp" android:layout_marginBottom="12dp"
                android:inputType="textMultiLine" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <Button android:id="@+id/btnStartVpn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="48dp" android:text="START VPN" android:textColor="#FFFFFF"
                    android:textStyle="bold" android:backgroundTint="#059669"/>
                <Space android:layout_width="8dp" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnStopVpn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="48dp" android:text="STOP VPN" android:textColor="#FFFFFF"
                    android:textStyle="bold" android:backgroundTint="#DC2626"/>
            </LinearLayout>

            <TextView android:id="@+id/vpnStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="VPN: Disconnected"
                android:textColor="#94A3B8" android:gravity="center" android:textSize="12sp"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
