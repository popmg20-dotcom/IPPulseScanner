<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/setting_override_category_title">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_round_network_check_24"
            app:key="@string/setting_override_lan_share_key"
            app:summary="@string/setting_override_lan_share_summary"
            app:title="@string/setting_override_lan_share_title"
            app:widgetLayout="@layout/layout_switch_preference"/>
        <ListPreference
            app:defaultValue="lan"
            app:dependency="@string/setting_override_lan_share_key"
            app:entries="@array/setting_override_lan_share_listen_entries"
            app:entryValues="@array/setting_override_lan_share_listen_entry_values"
            app:key="@string/setting_override_lan_share_listen_key"
            app:title="@string/setting_override_lan_share_listen_title"
            app:useSimpleSummaryProvider="true"/>
        <EditTextPreference
            app:defaultValue="1234"
            app:dependency="@string/setting_override_lan_share_key"
            app:dialogLayout="@layout/preference_dialog_port"
            app:key="@string/setting_override_lan_share_http_port_key"
            app:positiveButtonText="@string/save"
            app:title="@string/setting_override_lan_share_http_port_title"
            app:useSimpleSummaryProvider="true"/>
        <EditTextPreference
            app:defaultValue="1235"
            app:dependency="@string/setting_override_lan_share_key"
            app:dialogLayout="@layout/preference_dialog_port"
            app:key="@string/setting_override_lan_share_socks5_port_key"
            app:positiveButtonText="@string/save"
            app:title="@string/setting_override_lan_share_socks5_port_title"
            app:useSimpleSummaryProvider="true"/>
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_round_https_24"
            app:key="@string/setting_bypass_tls_verify_key"
            app:summary="@string/setting_bypass_tls_verify_summary"
            app:title="@string/setting_bypass_tls_verify_title"
            app:widgetLayout="@layout/layout_switch_preference"/>
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_round_nat_24"
            app:key="@string/setting_force_udp_relay_key"
            app:summary="@string/setting_force_udp_relay_summary"
            app:title="@string/setting_force_udp_relay_title"
            app:widgetLayout="@layout/layout_switch_preference"/>
        <ListPreference
            app:defaultValue="follow_profile"
            app:entries="@array/setting_override_ipv6_entries"
            app:entryValues="@array/setting_override_ipv6_entry_values"
            app:icon="@drawable/ic_round_settings_ethernet_24"
            app:key="@string/setting_override_ipv6_key"
            app:title="@string/setting_override_ipv6_title"
            app:useSimpleSummaryProvider="true"/>
        <Preference
            app:icon="@drawable/ic_round_private_connectivity_24"
            app:isPreferenceVisible="@bool/is_not_tv"
            app:key="@string/setting_override_doh_v2_key"
            app:title="@string/setting_override_doh_title"/>
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/ic_round_dns_24"
            app:key="@string/setting_force_remote_dns_key"
            app:summary="@string/setting_force_remote_dns_mode_summary"
            app:title="@string/setting_force_remote_dns_mode_title"
            app:widgetLayout="@layout/layout_switch_preference"/>
        <Preference
            app:icon="@drawable/ic_round_edit_road_24"
            app:key="@string/setting_hosts_key"
            app:persistent="false"
            app:summary="@string/setting_hosts_summary"
            app:title="@string/setting_hosts_title"/>
    </PreferenceCategory>
</PreferenceScreen>
