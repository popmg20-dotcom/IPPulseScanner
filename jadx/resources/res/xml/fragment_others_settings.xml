<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/setting_others_category_title">
        <Preference
            app:icon="@drawable/ic_round_bug_report_24"
            app:isPreferenceVisible="@bool/is_not_tv"
            app:key="@string/setting_feedback_key"
            app:summary="@string/setting_feedback_summary"
            app:title="@string/setting_feedback_title"/>
        <Preference
            app:enableCopying="true"
            app:icon="@drawable/ic_round_android_24"
            app:isPreferenceVisible="@bool/is_not_tv"
            app:key="@string/setting_do_not_kill_my_app_key"
            app:persistent="false"
            app:summary="@string/setting_do_not_kill_my_app_summary"
            app:title="@string/setting_do_not_kill_my_app_title"/>
        <Preference
            app:icon="@drawable/ic_round_developer_mode_24"
            app:isPreferenceVisible="false"
            app:key="@string/setting_developer_options_key"
            app:title="@string/setting_developer_options_title"/>
        <Preference
            app:icon="@drawable/ic_round_double_arrow_24"
            app:key="@string/setting_version_key"
            app:persistent="false"
            app:title="@string/setting_version_title"/>
        <Preference
            app:icon="@drawable/ic_round_security_update_24"
            app:isPreferenceVisible="false"
            app:key="@string/setting_check_update_key"
            app:persistent="false"
            app:title="@string/setting_check_update_title"/>
        <Preference
            app:enableCopying="true"
            app:icon="@drawable/ic_round_history_24"
            app:key="@string/setting_changelog_key"
            app:persistent="false"
            app:title="@string/changelog"/>
        <Preference
            app:enableCopying="true"
            app:icon="@drawable/ic_round_privacy_tip_24"
            app:key="@string/setting_privacy_policy_key"
            app:persistent="false"
            app:title="@string/privacy_policy"/>
    </PreferenceCategory>
</PreferenceScreen>
