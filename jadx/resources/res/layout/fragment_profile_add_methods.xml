<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    app:cardElevation="8dp"
    app:strokeColor="@color/stroke_color"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:id="@+id/qrcode"
            android:background="?attr/selectableItemBackground"
            android:padding="16dp"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_from_qrcode"
            android:drawablePadding="16dp"
            android:drawableStart="@drawable/ic_round_qr_code_24"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:id="@+id/local_file"
            android:background="?attr/selectableItemBackground"
            android:padding="16dp"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_from_file"
            android:drawablePadding="16dp"
            android:drawableStart="@drawable/ic_round_insert_drive_file_24"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:id="@+id/start_from_scratch"
            android:background="?attr/selectableItemBackground"
            android:padding="16dp"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_from_scratch"
            android:drawablePadding="16dp"
            android:drawableStart="@drawable/ic_round_mode_edit_24"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="?attr/colorOnPrimary"
            android:layout_gravity="bottom"
            android:id="@+id/url"
            android:background="?attr/colorPrimary"
            android:padding="16dp"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/import_from_url"
            android:drawablePadding="16dp"
            android:drawableStart="@drawable/ic_round_link_24"
            app:drawableTint="?attr/colorOnPrimary"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
