<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkable="true"
        app:cardElevation="0dp"
        app:checkedIconSize="24dp"
        app:contentPaddingBottom="12sp"
        app:contentPaddingLeft="16dp"
        app:contentPaddingRight="12dp"
        app:contentPaddingTop="12dp"
        app:strokeColor="@color/stroke_color"
        app:strokeWidth="1dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="?attr/textAppearanceBody2"
                android:ellipsize="end"
                android:id="@+id/title"
                android:scrollbars="none"
                android:layout_width="0dp"
                android:layout_height="44sp"
                android:lines="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textAppearance="?attr/textAppearanceCaption"
                android:id="@+id/type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:id="@+id/udp_tag"
                android:background="@drawable/bg_proxy_udp_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:text="@string/udp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/delay"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/delay"/>
            <TextView
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="@color/transparent"
                android:id="@+id/delay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                app:layout_constraintEnd_toStartOf="@+id/udp_tag"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/type"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
